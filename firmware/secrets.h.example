// Template for firmware secrets — Layer 1 of docs/ota-and-secrets.md.
//
// Copy this file into the sketch folder that needs it (e.g.
// firmware/pomona/) as `secrets.h`, fill in the values, and NEVER
// commit the copy — `secrets.h` is gitignored repo-wide. The target
// design (#244) moves these into the ATECC608A secure element, after
// which this file goes away.

#pragma once

#define SECRET_WIFI_SSID "changeme"
#define SECRET_WIFI_PASS "changeme"

#define SECRET_MQTT_HOST "mqtt.lab.local" // in-cluster EMQX (docs/mqtt.md)
#define SECRET_MQTT_PORT 1883
#define SECRET_MQTT_USER "pomona"
#define SECRET_MQTT_PASS "changeme"
