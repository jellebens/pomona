// Template for firmware secrets — Layer 1 of docs/ota-and-secrets.md.
//
// ONLY the two passwords live here; everything else (SSID, MQTT host/
// port/user) is non-secret and sits in the sketch's config.h. Copy this
// file into the sketch folder that needs it (e.g. firmware/pomona/) as
// `secrets.h`, fill in the values, and NEVER commit the copy —
// `secrets.h` is gitignored repo-wide. The target design (#244) moves
// these into the ATECC608A secure element, after which this file goes
// away.

#pragma once

#define WIFI_PASS "changeme"
#define MQTT_PASS "changeme"
