// Template for firmware secrets — Layer 1 of docs/ota-and-secrets.md.
//
// Copy this file into the sketch folder that needs it (e.g.
// firmware/pomona-unit/) as `arduino_secrets.h`, fill in the values, and
// NEVER commit the copy — `arduino_secrets.h` is gitignored repo-wide.
// The target design (#244) moves these into the ATECC608A secure element,
// after which this file goes away.

#pragma once

#define SECRET_WIFI_SSID "changeme"
#define SECRET_WIFI_PASS "changeme"

#define SECRET_MQTT_HOST "changeme.lab.local"
#define SECRET_MQTT_PORT 1883
#define SECRET_MQTT_USER "pomona"
#define SECRET_MQTT_PASS "changeme"
